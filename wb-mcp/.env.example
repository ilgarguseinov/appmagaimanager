# Wildberries Seller API token (Seller portal -> Settings -> Access to API)
# Generate a token with the scopes matching the tools you plan to use:
# Content, Prices, Marketplace, Statistics, Promotion (Advert).
WB_API_KEY=your_wildberries_api_token

# Optional overrides if Wildberries changes a category's host.
# WB_CONTENT_API_URL=https://content-api.wildberries.ru
# WB_PRICES_API_URL=https://discounts-prices-api.wildberries.ru
# WB_MARKETPLACE_API_URL=https://marketplace-api.wildberries.ru
# WB_STATISTICS_API_URL=https://statistics-api.wildberries.ru
# WB_ADVERT_API_URL=https://advert-api.wildberries.ru
