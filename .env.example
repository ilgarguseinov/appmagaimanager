SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SHOP=appmag.myshopify.com
PORT=3000

OPENAI_API_KEY=your_openai_api_key

# Wildberries Seller API key (Content API + Prices API scopes)
WILDBERRIES_API_KEY=your_wildberries_api_key

# YouTube Data API v3 key (read-only: channel/video analytics)
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# YouTube OAuth2 credentials (only needed to actually schedule/upload videos)
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_google_oauth_refresh_token
